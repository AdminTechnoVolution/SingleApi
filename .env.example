# Variables nuevas para Stripe. Deben añadirse a la configuración existente de SingleApi.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_WEEKLY_PRICE_ID=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_QUARTERLY_PRICE_ID=
STRIPE_SUCCESS_URL=https://single.example.com/premium?status=success
STRIPE_CANCEL_URL=https://single.example.com/premium?status=cancelled
STRIPE_PORTAL_RETURN_URL=https://single.example.com/premium

# Blind dates — WebRTC TURN (credentials are minted per call, never shipped in the apps).
# Managed (recommended): Cloudflare Realtime TURN key
TURN_PROVIDER_KEY_ID=
TURN_PROVIDER_API_TOKEN=
# …or any TURN using the REST/HMAC scheme (coturn, Metered): comma-separated urls + shared secret
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIALS_TTL_SECS=3600
